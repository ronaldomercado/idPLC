# % archiver 10.0 Monitor
record(ai, "$(prefix)-TILT-01:TILT"){
    field(DESC, "Tilt sensor upper")
    field(DTYP, "EtherIP")
    field(SCAN, ".1 second")
    field(INP,  "@$(port) T.Measured[1]")
    field(FLNK, "$(prefix)-TILT-01:MRADS")
}
# % archiver 10.0 Monitor
record(ai, "$(prefix)-TILT-01:MRADS"){
  field(DESC, "Tilt sensor upper (mrad)")
  field(INP, "$(prefix)-TILT-01:TILT")
  field(EGU, "mrad")
  field(PREC, "4")
  field(ADEL, "0.005")
  field(MDEL, "0.0010")
}
