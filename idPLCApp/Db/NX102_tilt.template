# % macro, __doc__, Template to read an ID tilt sensor
# % macro, prefix, device prefix, e.g. SR02K-MO
# % macro, port, port name of ether_ip driver
# % macro, name, gui name
# % macro, idname, id name

# % gui, $(name), edm, idplc_Config.edl, prefix=$(prefix),idname=$(idname)

record(ao, "$(prefix)-TILT-01:OUT:UOFF"){
    field(DESC, "Tilt upper offset write")
    field(DTYP, "EtherIP")
    field(SCAN, "Passive")
    field(DRVH, "1000")
    field(DRVL, "-1000")
    field(OUT,  "@$(port) T.Offset[1] S 0.5")
    field(PREC, "3")
    field(EGU,  "mrad")
}

# % archiver 10.0 Monitor
record(ai, "$(prefix)-TILT-01:UOFF"){
    field(DESC, "Tilt upper offset")
    field(DTYP, "EtherIP")
    field(INP,  "@$(port) T.Offset_RB[1]")
    field(SCAN, "1 second")
    field(EGU,  "mrad")
    field(PREC, "3")
}

record(ao, "$(prefix)-TILT-02:OUT:LOFF"){
    field(DESC, "Tilt lower offset write")
