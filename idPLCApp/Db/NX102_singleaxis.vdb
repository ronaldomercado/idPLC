# Template to read signals for a single axis for the ID limits
# expanded in axisexp
# nn - number of the axis 1,2,3 or 4
# xxletters - letters to encode PVs of override: UDS, UUS, LDS or LUS
# xxdesc    - description of axis for DESC field
template() {

  #! InputMacro(nn,"",1660,20,16777215,1,false)
  #! InputMacro(xxletters,"",1660,20,16777215,1,false)
  #! InputMacro(xxdesc,"",1660,20,16777215,1,false)
}

# POT position
# % archiver 0.1 Monitor
record(ai, "$(prefix)-AXIS-0$(nn):RAW"){
  field(DESC, "Axis $(nn) Pot raw")
  field(DTYP, "EtherIP")
  field(INP,  "@$(port) PTS.Raw[$(nn)]")
  field(SCAN, ".5 second")
  field(EGU,  "")
  field(PREC, "4")
  field(ADEL, "1")
}

# % archiver 0.1 Monitor
record(ai, "$(prefix)-AXIS-0$(nn):ENCD"){
  field(DESC, "Axis $(nn) Pot pos in mm")
  field(DTYP, "EtherIP")
  field(INP,  "@$(port) PTS.Measured[$(nn)]")
  field(SCAN, ".5 second")
  field(EGU,  "mm")
  field(PREC, "4")
  field(ADEL, "0.02")
  field(FLNK, "$(prefix)-AXIS-0$(nn):POS")
}
# % archiver 0.1 Monitor
record(calc, "$(prefix)-AXIS-0$(nn):POS"){
  field(DESC, "Axis $(nn) Pot pos")
  field(INPA, "$(prefix)-AXIS-0$(nn):ENCD")
  field(CALC, "100000*A")
}

# POT offset
# % archiver 10.0 Monitor
record(ai, "$(prefix)-AXIS-0$(nn):OFF"){
  field(DESC, "Axis $(nn) pot offset")
  field(DTYP, "EtherIP")
  field(INP,  "@$(port) PTS.Offset_RB[$(nn)]")
  field(SCAN, ".5 second")
  field(EGU,  "mm")
  field(PREC, "4")
  field(ADEL, "1")
}

record(ao, "$(prefix)-AXIS-0$(nn):OUT:OFF"){
  field(DESC, "Axis $(nn) write pot offset")
  field(DTYP, "EtherIP")
  field(SCAN, "Passive")
  field(DRVH, "1000")
  field(DRVL, "-1000")
  field(PREC, "4")
  field(OUT,  "@$(port) PTS.Offset[$(nn)] S 0.5")
}

