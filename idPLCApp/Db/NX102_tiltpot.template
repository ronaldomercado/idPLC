# % macro, __doc__, Template to read an ID potentiometer tilt 
# % macro, prefix, device prefix, e.g. SR02K-MO
# % macro, port, port name of ether_ip driver

# % archiver 10.0 Monitor
record(ai, "$(prefix)-TILT-01:DER:MRADS"){
  field(DESC, "Tilt pot upper derived (mrad)")
  field(EGU, "mrad")
  field(PREC, "4")
  field(ADEL, "0.005")
  field(MDEL, "0.0010")
  field(DTYP, "EtherIP")
  field(SCAN, ".1 second")
  field(INP,  "@$(port) PT.Measured[1]")
}

# % archiver 10.0 Monitor
record(ai, "$(prefix)-TILT-02:DER:MRADS"){
  field(DESC, "Tilt pot lower derived (mrad)")
  field(EGU, "mrad")
  field(PREC, "4")
  field(ADEL, "0.005")
  field(MDEL, "0.0010")
  field(DTYP, "EtherIP")
  field(SCAN, ".1 second")
  field(INP,  "@$(port) PT.Measured[2]")
}

record(ai, "$(prefix)-STAT-01:DERSAFE") {
  field(DESC, "Tilt pot safe window")
  field(DTYP, "EtherIP")
  field(SCAN, "1 second")
  field(INP, "@$(port) PT.Safe_Window[1]")
}
record(ai, "$(prefix)-STAT-01:DERABS") {
  field(DESC, "Tilt pot absolute window")
  field(DTYP, "EtherIP")
  field(SCAN, "1 second")
  field(INP, "@$(port) T.Absolute_Window[1]")
}
record(ai, "$(prefix)-STAT-01:DEREXTR") {
  field(DESC, "Tilt pot extreme window")
  field(DTYP, "EtherIP")
  field(SCAN, "1 second")
  field(INP, "@$(port) T.Extreme_Window[1]")
