# GSF
# % archiver 10.0 Monitor
record(ai, "$(prefix)-STAT-01:ENCDIST"){
  field(DTYP, "EtherIP")
  field(SCAN, "1 second")
  field(INP, "@$(port) PT.GSF[1]")
  field(FLNK, "$(prefix)-STAT-01:BMLENGTH")
}

# Dummy record with arbitrary 40 mm added
# This is not implemented in plc code for collision protection.
# The original idea had to do with protection against clashes for beams
# far away from the encoder distance (large overhang) that could
# potentially clash.
record(calc, "$(prefix)-STAT-01:BMLENGTH") {
  field(DESC, "Magnet array beam length")
  field(CALC, "A+40")
  field(EGU, "mm")
  field(INPA, "$(prefix)-STAT-01:ENCDIST")
}
