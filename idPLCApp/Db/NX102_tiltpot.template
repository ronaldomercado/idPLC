record(ao, "$(prefix)-ORIDE-01:DERSAFE"){
  field(DESC, "Tilt pot upper safe window O/R")
  field(SCAN, "Passive")
  field(DTYP, "Soft Channel")
  field(OUT, "$(prefix)-ORIDE-01:DER:WR PP")
  field(DOL, "1")
  field(OMSL, "closed_loop")
  field(DRVH, "2")
