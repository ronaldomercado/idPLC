record(ai, "$(prefix)-TILT-01:DERSTA:INP") {
  field(DESC, "Tilt pot upper window status")
  field(DTYP, "EtherIP")
  field(INP, "@$(port) PT.Window[1]")
  field(SCAN, ".2 second")
  field(FLNK, "$(prefix)-TILT-01:DERSTA")
}

record(ai, "$(prefix)-TILT-02:DERSTA:INP") {
  field(DESC, "Tilt pot lower window status")
  field(DTYP, "EtherIP")
  field(INP, "@$(port) PT.Window[2]")
  field(SCAN, ".2 second")
  field(FLNK, "$(prefix)-TILT-02:DERSTA")
}

